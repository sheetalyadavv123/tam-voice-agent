# Copy to .env and fill in. Never commit real values.

# Environment: dev | staging | prod (reset_demo.py only runs when dev)
APP_ENV=

# LiveKit
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Model and voice providers
DEEPGRAM_API_KEY=
ELEVEN_API_KEY=
SARVAM_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=

# Database (Neon: dev branch locally, staging branch when deployed)
DATABASE_URL=

# Agent settings
COMPANY_NAME=
LLM_PROVIDER=
LLM_MODEL=
LLM_REASONING_EFFORT=
STT_MODEL=
STT_LANGUAGE=
TTS_PROVIDER=
SARVAM_LANGUAGE=
SARVAM_SPEAKER=
TTS_MODEL=
TTS_VOICE_ID=

# Policy overrides (optional, defaults in tools/policy.py)
VERIFICATION_MODE=
CALL_WINDOW_START=
CALL_WINDOW_END=
MAX_ATTEMPTS_PER_DAY=
MAX_ATTEMPTS_PER_WEEK=
MAX_PROMISE_DAYS=
MAX_LINK_SENDS_PER_CALL=
MAX_DOB_ATTEMPTS=
MAX_IMPOSSIBLE_DATES=
PROMISE_GRACE_DAYS=

# Testing
TEST_MODE=
TEST_CUSTOMER_ID=
TEST_CALLER_PHONE=
RUN_DB_TESTS=
